{
  "name": "knst-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3001 --host",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && wrangler deploy",
    "warm-cache": "node scripts/warm-cache.mjs",
    "db:migrate:local": "wrangler d1 migrations apply knst-demo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply knst-demo-db --remote",
    "typecheck": "wrangler types && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.62.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.3.1",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "react-server-dom-webpack": "^19.3.1",
    "typescript": "^5",
    "vite": "^8.3.0",
    "wrangler": "^4.154.0"
  },
  "type": "module"
}
